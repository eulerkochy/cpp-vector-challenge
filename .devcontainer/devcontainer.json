{
  // Build your own std::vector - devcontainer (Tier 1, the reference environment).
  // Works in GitHub Codespaces and VS Code "Reopen in Container".
  "name": "cppatlas: build your own std::vector",
  "build": { "dockerfile": "Dockerfile" },

  // Both compilers use GCC 16.2's libstdc++ (clang++-21 is pointed at it by a
  // config file in the image), so they see the same C++23 library.

  // ASan/LSan need ptrace; the default seccomp profile can block it.
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],

  "remoteUser": "vscode",
  "containerEnv": {
    // Default compiler is GCC 16.2 (g++). To use Clang 21 for one run:
    //   CXX=clang++-21 ./cppatlas test
    // (each compiler gets its own build directory, so switching is cheap).
    "CXX": "g++",
    "CC": "gcc"
  },

  // First configure + parallel build of stages 1-2 and the doctest main, so the first
  // ./cppatlas test is fast. Never fails container creation (the stubs fail
  // their tests on purpose).
  "postCreateCommand": "./cppatlas test 2 >/dev/null 2>&1 || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        // clangd reads compile_commands.json exported by the build.
        "clangd.arguments": [
          "--compile-commands-dir=${workspaceFolder}/build/debug-g++",
          "--background-index"
        ],
        "cmake.useCMakePresets": "always",
        "cmake.configureOnOpen": false,
        // clangd supplies IntelliSense; keep the Microsoft engine out of its way.
        "C_Cpp.intelliSenseEngine": "disabled",
        "files.associations": { "*.hpp": "cpp" },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
